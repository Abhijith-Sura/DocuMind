# DocuMind AI — Environment Variables
# Copy this to .env and fill in your keys

# Application
APP_NAME=DocuMind AI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind_db

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# LLM Provider
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here  # Alternative

# Reranking
COHERE_API_KEY=your-cohere-api-key-here

# Vector DB
CHROMA_PERSIST_DIR=./chroma_db
# PINECONE_API_KEY=your-pinecone-key  # For production

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu   # or "cuda" if you have GPU

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=http://localhost:3000
